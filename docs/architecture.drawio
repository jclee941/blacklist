        <!-- ==================== FLOW 5: CREDENTIAL MANAGEMENT ==================== -->
        <mxCell id="flow5-title" value="⑤ 자격증명 관리 흐름 (Credential Management)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#4e342e;" vertex="1" parent="1">
