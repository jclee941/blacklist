        <mxCell id="f1-route" value="&lt;b&gt;Route Handler&lt;/b&gt;&#xa;Blueprint&#xa;REST API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1-service" value="&lt;b&gt;Service Layer&lt;/b&gt;&#xa;Business Logic&#xa;DI via extensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="40" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&#xa;Raw SQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e8eaf6;strokeColor=#283593;fontSize=11;" vertex="1" parent="1">
