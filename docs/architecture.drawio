  <diagram id="data-flow" name="Data Flow">
    <mxGraphModel dx="2200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="df-title" value="Blacklist Intelligence Platform — Data Flow Diagram" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="-80" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW 1: USER REQUEST ==================== -->
        <mxCell id="flow1-title" value="① 사용자 요청 흐름 (User Request Flow)" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="50" y="0" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="f1-user" value="사용자" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f1-browser" value="Browser&#xa;(HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="45" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1-nextjs" value="&lt;b&gt;Next.js 15&lt;/b&gt;&#xa;SSR/CSR&#xa;(:443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1-axios" value="&lt;b&gt;Axios&lt;/b&gt;&#xa;JWT Bearer&#xa;Auto-attach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1-middleware" value="&lt;b&gt;JWT Middleware&lt;/b&gt;&#xa;before_request&#xa;Token 검증" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="40" width="120" height="60" as="geometry" />
