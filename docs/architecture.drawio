        <mxCell id="f2-intercept" value="Axios Interceptor&#xa;Authorization:&#xa;Bearer {token}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="200" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2-401" value="401 → /login&#xa;Redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="200" width="100" height="60" as="geometry" />
