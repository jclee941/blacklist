# ==============================================================================
# Blacklist Intelligence Platform - Git Attributes
# ==============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# ============================================================================
# Source Code
# ============================================================================
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf diff=python
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# ============================================================================
# Configuration
# ============================================================================
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
.env* text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# ============================================================================
# Documentation
# ============================================================================
*.md text eol=lf diff=markdown
*.txt text eol=lf
LICENSE* text eol=lf
CHANGELOG* text eol=lf
README* text eol=lf

# ============================================================================
# Web & Data
# ============================================================================
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.sql text eol=lf
*.csv text eol=lf

# ============================================================================
# Binary Files
# ============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.pdf binary
*.db binary
*.sqlite binary

# ============================================================================
# Lock Files (binary diff to avoid merge conflicts)
# ============================================================================
package-lock.json binary

# ============================================================================
# Export Ignore (excluded from git archive)
# ============================================================================
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
*.test.* export-ignore
*.spec.* export-ignore

# ============================================================================
# Linguist (GitHub language detection)
# ============================================================================
docs/** linguist-documentation
*.md linguist-documentation
node_modules/** linguist-vendored
