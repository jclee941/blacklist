# =============================================================================
# Blacklist Platform — Deploy Environment Variables
# =============================================================================
# install.sh creates deploy/.env on the target during the first installation.
# Keep that file unchanged across upgrades and back it up with the database.
# =============================================================================

# ---------------------------------------------------------------------------
# Docker Compose Project Name (REQUIRED — prevents versioned volume names)
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=blacklist

# ---------------------------------------------------------------------------
# Target bootstrap values (REQUIRED — generated locally, never distributed)
# ---------------------------------------------------------------------------
CREDENTIAL_MASTER_KEY=
SECRET_KEY=
COLLECTOR_AUTH_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=
ENCRYPTION_SALT=
SETTINGS_ENCRYPTION_KEY=
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# POSTGRES_HOST=blacklist-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=blacklist
# POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# DATABASE_URL=                  # Alternative: single DSN overrides above
# POSTGRES_FALLBACK_HOSTS=blacklist-postgres,postgres,localhost  # Comma-separated fallback hosts for DB recovery

# ---------------------------------------------------------------------------
# Redis (REDIS_PASSWORD REQUIRED — generated locally, never distributed)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
# REDIS_HOST=blacklist-redis
# REDIS_PORT=6379
# RATE_LIMIT_WHITELIST=127.0.0.1,localhost,172.,192.168.  # Comma-separated IPs/prefixes exempt from rate limiting (entries ending with '.' are prefix matches)

# ---------------------------------------------------------------------------
# Service URLs (optional — defaults use Docker service names)
# ---------------------------------------------------------------------------
# COLLECTOR_URL=http://blacklist-collector:8545
# BLACKLIST_API_URL=http://blacklist-app:2542/api

# ---------------------------------------------------------------------------
# REGTECH Credentials (configure and save in the collection management UI)
# REGTECH_BASE_URL=https://regtech.fsec.or.kr

# ---------------------------------------------------------------------------
# Application Settings (optional — sensible defaults provided)
# ---------------------------------------------------------------------------
# APP_PORT=2542
# FLASK_ENV=production
# FLASK_DEBUG=false
# LOG_LEVEL=INFO
# LOG_DIR=/app/logs
# DISABLE_AUTO_COLLECTION=false
# COLLECTION_INTERVAL=3600          # Code default: 3600s (1h), deploy override: 86400s (24h)

# ---------------------------------------------------------------------------
# Resilience (optional — tune DB connection retry behavior)
# ---------------------------------------------------------------------------
# DB_CONNECT_RETRIES=10
# DB_BACKOFF_DELAY=2.0

# ---------------------------------------------------------------------------
# Build Metadata (set automatically by CI — do not set manually)
# ---------------------------------------------------------------------------
# APP_VERSION=
# VERSION=
# COMMIT_HASH=
# BUILD_NUMBER=
# VCS_REF=

# ---------------------------------------------------------------------------
# GitHub Integration (optional — for release automation)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ---------------------------------------------------------------------------
# Runtime Identity (optional — set automatically by Docker)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# SERVICE_NAME=blacklist-app
# HOSTNAME=
# MIGRATION_KEY=cleanup-2025-09-03
