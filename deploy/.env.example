# =============================================================================
# Blacklist Platform — Deploy Environment Secrets
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Auto-generated by install.sh on first deployment.
# For manual setup, generate keys with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Encryption keys (REQUIRED)
CREDENTIAL_MASTER_KEY=
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Database credentials (optional, defaults to 'postgres')
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=blacklist

# SECUDIUM collection credentials (optional)
SECUDIUM_EMAIL=
SECUDIUM_EMAIL_PASSWORD=
