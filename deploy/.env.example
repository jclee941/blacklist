# =============================================================================
# Blacklist Platform — Deploy Environment Variables
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Auto-generated by install.sh on first deployment.
# For manual setup, generate keys with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ---------------------------------------------------------------------------
# Encryption & Auth Keys (REQUIRED — no defaults, app may fail without these)
# ---------------------------------------------------------------------------
CREDENTIAL_MASTER_KEY=
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
ENCRYPTION_SALT=
SETTINGS_ENCRYPTION_KEY=
FLASK_SECRET_KEY=
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (optional — defaults to Docker service name)
# ---------------------------------------------------------------------------
# POSTGRES_HOST=blacklist-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=blacklist
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# DATABASE_URL=                  # Alternative: single DSN overrides above

# ---------------------------------------------------------------------------
# Redis (optional — defaults to Docker service name)
# ---------------------------------------------------------------------------
# REDIS_HOST=blacklist-redis
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Service URLs (optional — defaults use Docker service names)
# ---------------------------------------------------------------------------
# COLLECTOR_URL=http://localhost:8545
# BLACKLIST_API_URL=http://localhost:2542/api

# ---------------------------------------------------------------------------
# FortiManager Integration (optional — leave empty to disable)
# ---------------------------------------------------------------------------
# FMG_HOST=
# FMG_USER=admin
# FMG_PASS=
# FMG_ADOM=root

# ---------------------------------------------------------------------------
# REGTECH Credentials (optional — prefer UI configuration)
# ---------------------------------------------------------------------------
# REGTECH_ID=
# REGTECH_PW=
# REGTECH_BASE_URL=https://regtech.fsec.or.kr

# ---------------------------------------------------------------------------
# SECUDIUM Credentials (optional)
# ---------------------------------------------------------------------------
SECUDIUM_EMAIL=
SECUDIUM_EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Admin Account (optional — defaults to admin/admin)
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# ADMIN_RESET_KEY=

# ---------------------------------------------------------------------------
# Application Settings (optional — sensible defaults provided)
# ---------------------------------------------------------------------------
# APP_PORT=2542
# FLASK_ENV=production
# FLASK_DEBUG=false
# LOG_LEVEL=INFO
# LOG_DIR=/app/logs
# DISABLE_JWT_AUTH=false
# DISABLE_AUTO_COLLECTION=false
# COLLECTION_INTERVAL=3600

# ---------------------------------------------------------------------------
# Resilience (optional — tune DB connection retry behavior)
# ---------------------------------------------------------------------------
# DB_CONNECT_RETRIES=10
# DB_BACKOFF_DELAY=2.0

# ---------------------------------------------------------------------------
# Build Metadata (set automatically by CI — do not set manually)
# ---------------------------------------------------------------------------
# APP_VERSION=
# VERSION=
# COMMIT_HASH=
# BUILD_NUMBER=
# VCS_REF=

# ---------------------------------------------------------------------------
# GitHub Integration (optional — for release automation)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ---------------------------------------------------------------------------
# Runtime Identity (optional — set automatically by Docker)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# SERVICE_NAME=blacklist-app
# HOSTNAME=
# MIGRATION_KEY=cleanup-2025-09-03
